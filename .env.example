# Copy to .env or set these in your host's dashboard. NEVER commit real values.
PORT=3000
ADMIN_TOKEN=            # 24+ random characters; enables /admin.html
RAZORPAY_KEY_ID=        # from Razorpay dashboard (test key first: rzp_test_...)
RAZORPAY_KEY_SECRET=    # server only
RAZORPAY_WEBHOOK_SECRET=# set the same value in Razorpay > Webhooks
TRUST_PROXY=0           # set 1 only behind a trusted reverse proxy
